# Public Supabase configuration. Both values are safe in the browser: row-level
# security protects user data, not key secrecy. Project settings > API.
# A newer sb_publishable_... key works in the anon key slot.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public CARTO basemap key used by browser tile requests.
NEXT_PUBLIC_CARTO_API_KEY=

# Operator-only. Used by the documented psql migration/import commands, never
# read by the application.
DATABASE_URL=
